# ---------------------------------------------------------------------------
# Client-side (VITE_*) — these are compiled into the public bundle.
# Never put a secret here.
# ---------------------------------------------------------------------------

# Base URL of the employee portal backend's public blog API
# (github.com/BurntStack/EmployeePortal-blog) — burntstack.com/blog reads
# its published posts from here.
VITE_BLOG_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Server-side — read by the Vercel functions in api/ only, never by src/.
# Set these in the Vercel dashboard (Project → Settings → Environment
# Variables), not in a committed file.
# ---------------------------------------------------------------------------

# Groq, for the site assistant (api/chat.js). Without it the chat widget
# tells visitors to use WhatsApp instead.
GROQ_API_KEY=

# Optional override. Defaults to openai/gpt-oss-120b, which falls back to
# openai/gpt-oss-20b on its own when Groq rate-limits the primary.
GROQ_MODEL=

# Resend, for lead notification emails (api/lead.js and api/chat.js).
# Both send to socials@burntstack.com.
RESEND_API_KEY=
